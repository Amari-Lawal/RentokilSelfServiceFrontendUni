# Build Stage
FROM node:20-alpine as build-stage
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Pass the production API URL during build time
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Production Stage
FROM nginx:stable-alpine as production-stage

# 1. Copy your build files
COPY --from=build-stage /app/dist /usr/share/nginx/html

# 2. Copy your config as a TEMPLATE
# Move your nginx.conf to /etc/nginx/templates/default.conf.template
COPY nginx.conf /etc/nginx/templates/default.conf.template

# 3. Cloud Run needs to be able to write to these directories
RUN chmod -R 777 /var/cache/nginx /var/run /var/log/nginx

# 4. Use 'envsubst' to replace $PORT in your config at runtime
CMD ["/bin/sh", "-c", "envsubst '${PORT}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]