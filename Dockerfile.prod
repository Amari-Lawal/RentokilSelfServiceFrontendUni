# --- Build Stage ---
FROM node:20-alpine as build-stage
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# --- Production Stage ---
FROM node:20-alpine
WORKDIR /app

# Install the static server globally
RUN npm install -g serve

# Copy only the built files from the build stage
COPY --from=build-stage /app/dist ./dist

# Use the $PORT variable provided by Cloud Run
# -s flag handles SPA routing (redirects 404s to index.html)
CMD ["sh", "-c", "serve -s dist -l 8080"]