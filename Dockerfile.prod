# --- Stage 1: Build ---
FROM node:20-alpine AS builder
WORKDIR /app

# Install dependencies first (better caching)
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source and build
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# --- Stage 2: Production ---
FROM node:20-alpine AS runner
WORKDIR /app

# Install 'serve' - it's much lighter than the Vite dev server
RUN npm install -g serve

# Copy only the compiled static files from the builder
COPY --from=builder /app/dist ./dist

# Standardize on a non-root user for security
USER node

# Serve the static files on the port Cloud Run provides
# -s handles Single Page App routing (prevents 404 on refresh)
CMD ["sh", "-c", "serve -s dist -l 8080"]